{
  "version": 2,
  "name": "study-buddy-web-and-apk",
  "public": true,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|manifest\\.json|sw\\.js|StudyBuddy\\.apk).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/StudyBuddy.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"StudyBuddy.apk\""
        }
      ]
    }
  ]
}
